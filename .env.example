PORT=3000
# 每1分鐘檢查一次（cron）
CHECK_INTERVAL=*/1 * * * *

# Gmail SMTP（建議使用 App Password）
EMAIL_TO=your_email@example.com
EMAIL_FROM=your_email@example.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_app_password

# Telegram 備援（可選）
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_IDS=123456789,987654321

# LINE Notify 備援（可選）
LINE_NOTIFY_TOKEN=your_line_notify_token

# 抓頁面穩定性設定（可選）
# 每次請求超時時間（毫秒）
FETCH_TIMEOUT_MS=18000

# 請求重試次數（每個事件）
FETCH_RETRY_ATTEMPTS=4

# 重試等待退避基礎毫秒 + 最大上限
FETCH_RETRY_BASE_MS=800
FETCH_RETRY_MAX_MS=12000

# 當重試仍失敗時，是否改用 Puppeteer（需安裝 puppeteer）
FETCH_BROWSER_FALLBACK=false

# Puppeteer 瀏覽器載入超時（毫秒）
BROWSER_TIMEOUT_MS=45000
